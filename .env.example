# Orbyte Environment Configuration Template
# Copy this file to .env and fill in your values

# -------------------------------------------------------------
# AI Inference Engine Configuration (DeepSeek Cloud or RunPod)
# -------------------------------------------------------------

# For RunPod Serverless:
# RUNPOD_ENDPOINT_URL=https://api.runpod.ai/v2/<your-endpoint-id>/runsync
# RUNPOD_API_KEY=rpa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RUNPOD_ENDPOINT_ID=your-endpoint-id

# For DeepSeek Cloud API:
RUNPOD_ENDPOINT_URL=https://api.deepseek.com/chat/completions
RUNPOD_API_KEY=sk-your-deepseek-api-key-here
RUNPOD_MODEL=deepseek-flash

# -------------------------------------------------------------
# Server Configuration
# -------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
